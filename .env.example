# Friendly Battle (online PvP) - see docs/FRIENDLY-BATTLE.md for full setup instructions.
# Both of these are PUBLIC values (safe to ship to the browser) - never put a service-role secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only - set this in your Vercel project's environment variables, NOT in this file, and NEVER
# with a VITE_ prefix (that would ship it to the browser bundle). Used only by the api/ functions.
# SUPABASE_SERVICE_ROLE_KEY=
